{
    "compilerOptions": {
      "target": "es2020",
      "module": "CommonJS",
      "moduleResolution": "node",
      "outDir": "./dist",
      "rootDir": "./src",
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "types": ["node"],
      "lib": ["es2021", "dom"],
      "ignoreDeprecations": "6.0"
    },
    "include": ["src/excelApi/**/*"],
    "exclude": ["node_modules"]
  }
  