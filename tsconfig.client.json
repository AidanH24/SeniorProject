{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "lib": ["DOM", "ES2021"],
    "outDir": "public/js",
    "rootDir": "./src/client",
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["src/client/"],
  "exclude": ["node_modules", "**/*.js"]
}